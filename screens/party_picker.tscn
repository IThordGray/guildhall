[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://screens/party_picker.gd" id="1_picker"]

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_screen"]

[node name="PartyPicker" type="PanelContainer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxEmpty_screen")
script = ExtResource("1_picker")

[node name="Root" type="VBoxContainer" parent="."]
visible = false
layout_mode = 2
theme_override_constants/separation = 24

[node name="Quest" type="PanelContainer" parent="Root"]
layout_mode = 2

[node name="Box" type="VBoxContainer" parent="Root/Quest"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Heading" type="HBoxContainer" parent="Root/Quest/Box"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Root/Quest/Box/Heading"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Heading"
text = "Wolves at the mill"
autowrap_mode = 3

[node name="Meta" type="Label" parent="Root/Quest/Box"]
layout_mode = 2
theme_type_variation = &"MetaSmall"
text = "E · 0:10 · 22g · fail 0g"

[node name="StoryLine" type="Label" parent="Root/Quest/Box"]
visible = false
layout_mode = 2
theme_type_variation = &"Caption"
text = "Story quest · stays until done"

[node name="FloorLine" type="Label" parent="Root/Quest/Box"]
visible = false
layout_mode = 2
theme_type_variation = &"Caption"
text = "Expedition · success explores +20% and brings 3 Glowmoss; failure +5% and 1"
autowrap_mode = 3

[node name="Coverage" type="HFlowContainer" parent="Root/Quest/Box"]
layout_mode = 2
theme_type_variation = &"Chips"

[node name="Party" type="HBoxContainer" parent="Root/Quest/Box"]
layout_mode = 2
theme_override_constants/separation = 40

[node name="Slots" type="HBoxContainer" parent="Root/Quest/Box/Party"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Chance" type="VBoxContainer" parent="Root/Quest/Box/Party"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12
alignment = 1

[node name="Line" type="HBoxContainer" parent="Root/Quest/Box/Party/Chance"]
layout_mode = 2

[node name="Label" type="Label" parent="Root/Quest/Box/Party/Chance/Line"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Caption"
text = "Chance"
vertical_alignment = 1

[node name="Odds" type="Label" parent="Root/Quest/Box/Party/Chance/Line"]
layout_mode = 2
theme_type_variation = &"GoldText"
text = "55–75%"

[node name="Band" type="Control" parent="Root/Quest/Box/Party/Chance"]
custom_minimum_size = Vector2(0, 11)
layout_mode = 2

[node name="Track" type="Panel" parent="Root/Quest/Box/Party/Chance/Band"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"RangeTrack"

[node name="Fill" type="Panel" parent="Root/Quest/Box/Party/Chance/Band"]
layout_mode = 1
anchor_left = 0.55
anchor_right = 0.75
anchor_bottom = 1.0
grow_vertical = 2
theme_type_variation = &"RangeBand"

[node name="WhoGoes" type="HBoxContainer" parent="Root"]
layout_mode = 2

[node name="Section" type="Label" parent="Root/WhoGoes"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Section"
text = "WHICH PARTY"

[node name="Hint" type="Label" parent="Root/WhoGoes"]
layout_mode = 2
theme_type_variation = &"Caption"
text = "tap one to pick it"
vertical_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Root"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 3

[node name="Box" type="VBoxContainer" parent="Root/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 24

[node name="List" type="VBoxContainer" parent="Root/Scroll/Box"]
layout_mode = 2
theme_type_variation = &"RowList"

[node name="Reserves" type="Label" parent="Root/Scroll/Box"]
visible = false
layout_mode = 2
theme_type_variation = &"Caption"
text = "2 in reserve can't go: not in a party"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Reason" type="Label" parent="Root"]
layout_mode = 2
theme_type_variation = &"AlertSmall"
text = "Pick a party"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Cancel" type="Button" parent="Root/Buttons"]
