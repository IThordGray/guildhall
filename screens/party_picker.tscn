[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://screens/party_picker.gd" id="1_picker"]

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_screen"]

[node name="PartyPicker" type="PanelContainer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxEmpty_screen")
script = ExtResource("1_picker")

[node name="Root" type="VBoxContainer" parent="."]
visible = false
layout_mode = 2
theme_override_constants/separation = 28

[node name="Scroll" type="ScrollContainer" parent="Root"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Box" type="VBoxContainer" parent="Root/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 28

[node name="Heading" type="VBoxContainer" parent="Root/Scroll/Box"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Root/Scroll/Box/Heading"]
layout_mode = 2
theme_type_variation = &"Title"
text = "Goblin camp"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Meta" type="Label" parent="Root/Scroll/Box/Heading"]
layout_mode = 2
theme_type_variation = &"Meta"
text = "Rank E · 10:00 · 500 gold"
horizontal_alignment = 1

[node name="List" type="GridContainer" parent="Root/Scroll/Box"]
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 24

[node name="Forecast" type="PanelContainer" parent="Root/Scroll/Box"]
layout_mode = 2

[node name="Box" type="VBoxContainer" parent="Root/Scroll/Box/Forecast"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Coverage" type="HFlowContainer" parent="Root/Scroll/Box/Forecast/Box"]
layout_mode = 2
theme_type_variation = &"Chips"

[node name="Chance" type="HBoxContainer" parent="Root/Scroll/Box/Forecast/Box"]
layout_mode = 2

[node name="Label" type="Label" parent="Root/Scroll/Box/Forecast/Box/Chance"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Secondary"
text = "Chance of success"
vertical_alignment = 2

[node name="Odds" type="Label" parent="Root/Scroll/Box/Forecast/Box/Chance"]
layout_mode = 2
theme_type_variation = &"GoldAmount"
text = "45–80%"

[node name="Band" type="Control" parent="Root/Scroll/Box/Forecast/Box"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2

[node name="Track" type="Panel" parent="Root/Scroll/Box/Forecast/Box/Band"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"RangeTrack"

[node name="Fill" type="Panel" parent="Root/Scroll/Box/Forecast/Box/Band"]
layout_mode = 1
anchor_left = 0.45
anchor_right = 0.8
anchor_bottom = 1.0
grow_vertical = 2
theme_type_variation = &"RangeBand"

[node name="Note" type="Label" parent="Root/Scroll/Box/Forecast/Box"]
layout_mode = 2
theme_type_variation = &"Secondary"
text = "If it fails: 125 gold."
autowrap_mode = 3

[node name="Reason" type="Label" parent="Root"]
layout_mode = 2
theme_type_variation = &"Alert"
text = "Pick at least one adventurer"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 40
alignment = 1

[node name="Send" type="Button" parent="Root/Buttons"]
custom_minimum_size = Vector2(300, 120)
layout_mode = 2
theme_type_variation = &"GoldButton"
text = "Send"

[node name="Cancel" type="Button" parent="Root/Buttons"]
custom_minimum_size = Vector2(300, 120)
layout_mode = 2
text = "Back"

[node name="Prompt" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"Secondary"
text = "Pick a quest"
horizontal_alignment = 1
vertical_alignment = 1
