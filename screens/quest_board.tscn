[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://screens/quest_board.gd" id="1_board"]

[node name="QuestBoard" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_board")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 32

[node name="Title" type="Label" parent="Box"]
layout_mode = 2
theme_type_variation = &"Title"
text = "Quests"

[node name="Status" type="Label" parent="Box"]
layout_mode = 2
theme_type_variation = &"Numbers"
text = "Party is home"
