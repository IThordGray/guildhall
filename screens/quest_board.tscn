[node name="Result" type="Label" parent="Box"]
visible = false
layout_mode = 2
autowrap_mode = 3

[node name="List" type="VBoxContainer" parent="Box"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Empty" type="Label" parent="Box"]
layout_mode = 2
theme_type_variation = &"Secondary"
text = "No more quests today"
horizontal_alignment = 1
